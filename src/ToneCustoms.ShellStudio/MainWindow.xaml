<Window x:Class="ToneCustoms.ShellStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ToneCustoms Shell Studio" Width="1600" Height="950" WindowStartupLocation="CenterScreen" Background="#101014" Foreground="White" KeyDown="Window_KeyDown"><Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#24242D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#343442"/><Setter Property="Padding" Value="12,8"/></Style></Window.Resources><Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#17171D"><DockPanel Margin="18,0"><TextBlock Text="TONECUSTOMS SHELL STUDIO" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="NEW" Click="New_Click" Margin="5"/><Button Content="OPEN" Click="Open_Click" Margin="5"/><Button Content="SAVE" Click="Save_Click" Margin="5"/><Button Content="UNDO" Click="Undo_Click" Margin="5"/><Button Content="DUPLICATE" Click="Duplicate_Click" Margin="5"/><Button Content="TEST SHELL (F5)" Click="Test_Click" Margin="5"/><Button Content="EXPORT TO FIVEM" Click="Export_Click" Margin="5" Background="#5A36A8"/></StackPanel></DockPanel></Border><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/><ColumnDefinition Width="315"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#15151A"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="BUILD" FontWeight="Bold"/><Button Content="Wall" Tag="Wall" Click="AddObject_Click" Margin="0,4"/><Button Content="Room" Tag="Room" Click="AddObject_Click" Margin="0,4"/><Button Content="Floor" Tag="Floor" Click="AddObject_Click" Margin="0,4"/><Button Content="Ceiling" Tag="Ceiling" Click="AddObject_Click" Margin="0,4"/><Button Content="Door" Tag="Door" Click="AddObject_Click" Margin="0,4"/><Button Content="Window" Tag="Window" Click="AddObject_Click" Margin="0,4"/><Button Content="Stairs" Tag="Stairs" Click="AddObject_Click" Margin="0,4"/><Separator Margin="0,12"/><TextBlock Text="EDITOR" FontWeight="Bold"/><Button Content="Move (W)" Click="Move_Click" Margin="0,4"/><Button Content="Rotate (E)" Click="Rotate_Click" Margin="0,4"/><Button Content="Scale (R)" Click="Scale_Click" Margin="0,4"/><Button Content="Delete Selected" Click="Delete_Click" Margin="0,4"/><Separator Margin="0,12"/><TextBlock Text="ASSETS" FontWeight="Bold"/><Button Content="Materials / DDS" Click="Materials_Click" Margin="0,4"/><Button Content="Props" Click="Props_Click" Margin="0,4"/><Button Content="Import Model" Click="Import_Click" Margin="0,4"/><Separator Margin="0,12"/><Button Content="Dependency Check" Click="Dependencies_Click"/><Button Content="Simple / Advanced" Click="Mode_Click" Margin="0,5"/></StackPanel></ScrollViewer></Border><Border Grid.Column="1" Background="#0C0C10"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="3D VIEWPORT FOUNDATION" Foreground="#888895" FontSize="24"/><TextBlock x:Name="ViewportInfo" Text="Grid • XYZ • Snapping • Floors • Walk • Collision • Bounds" Foreground="#5E5E6B" Margin="0,10"/></StackPanel><ListBox x:Name="SceneList" Width="260" Height="220" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="15" Background="#18181E" Foreground="White" SelectionChanged="SceneList_SelectionChanged" DisplayMemberPath="Name"/></Grid></Border><Border Grid.Column="2" Background="#15151A"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="PROPERTIES" FontWeight="Bold"/><TextBlock x:Name="SelectedName" Text="Nothing selected" FontSize="16" Margin="0,8"/><TextBlock Text="Position XYZ"/><TextBox x:Name="PositionBox" Text="0, 0, 0"/><TextBlock Text="Rotation XYZ" Margin="0,7,0,0"/><TextBox x:Name="RotationBox" Text="0, 0, 0"/><TextBlock Text="Scale XYZ" Margin="0,7,0,0"/><TextBox x:Name="ScaleBox" Text="1, 1, 1"/><Button Content="APPLY TRANSFORM" Click="ApplyTransform_Click" Margin="0,10"/><Separator/><TextBlock Text="VALIDATION" FontWeight="Bold" Margin="0,8"/><TextBlock x:Name="ValidationText" Text="Not checked" TextWrapping="Wrap"/><Button Content="VALIDATE" Click="Validate_Click" Margin="0,8"/><Button Content="SAFE AUTOFIX" Click="AutoFix_Click"/><Separator Margin="0,10"/><CheckBox x:Name="SnapCheck" Content="Grid snapping" IsChecked="True"/><CheckBox x:Name="CollisionCheck" Content="Collision view"/><CheckBox x:Name="BoundsCheck" Content="Bounds view"/><TextBlock x:Name="PerformanceText" Text="Objects: 0" Margin="0,12"/></StackPanel></ScrollViewer></Border></Grid><Border Grid.Row="2" Background="#17171D"><TextBlock x:Name="StatusText" Text="Ready • Simple Mode • Project: Untitled" Margin="12,6" Foreground="#A8A8B3"/></Border></Grid></Window>